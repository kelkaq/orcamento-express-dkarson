# NÃO inclua segredos reais no GitHub, APK ou backups.
PORT=8089
DATABASE_URL=postgresql://online_user:COLOQUE_SENHA_FORTE@127.0.0.1:5432/dkarson_online
PUBLIC_BASE_URL=https://api.seu-dominio.com
OTP_HMAC_KEY=COLOQUE_64_CARACTERES_HEX_ALEATORIOS
BACKUP_ENCRYPTION_KEY_BASE64=COLOQUE_CHAVE_AES_256_DE_32_BYTES_EM_BASE64
SMTP_HOST=smtp.seu-provedor.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=conta@seu-dominio.com
SMTP_PASSWORD=SEGREDO
MAIL_FROM=DKARSON <conta@seu-dominio.com>
PLAY_PACKAGE_NAME=com.dkarson.orcamentoexpress
PLAY_SUBSCRIPTION_ID=orcamento_express_pro_mensal
GOOGLE_APPLICATION_CREDENTIALS=/etc/dkarson/google-service-account.json

# OAuth Web Client ID público, igual ao usado no build Android.
GOOGLE_WEB_CLIENT_ID=SEU_ID.apps.googleusercontent.com
# Para Supabase Postgres: DATABASE_URL pode apontar ao pooler SESSION (porta 5432).
# Não utilizar senha ou service-role do Supabase diretamente no APK.
DATABASE_SSL=true
\n# Google Cloud Pub/Sub push autenticado para notificações Google Play\nPUBSUB_PUSH_AUDIENCE=https://api.seu-dominio.com/v1/play/rtdn\nPUBSUB_PUSH_SERVICE_ACCOUNT_EMAIL=play-push@seu-projeto.iam.gserviceaccount.com\n